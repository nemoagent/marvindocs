      "description": "Laravel docs from github.com/laravel/docs (branch {v})"
    },
    {
      "parser": "laravel",
      "slug": "laravel~{v}",
      "args": ["--version", "{v}.x"],
      "versions": ["6", "7", "8", "9", "10", "11", "12", "13"],
      "description": "Laravel docs from github.com/laravel/docs (branch {v}.x)"
    },
    {
      "parser": "go-dev",
      "slug": "go-dev",
      "args": ["--mode", "overview"],
      "description": "Go conceptual docs from go.dev (install, Effective Go, FAQ, modules, spec)"
    },
    {
      "parser": "go-dev",
      "slug": "go-dev~{v}",
