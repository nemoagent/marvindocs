{
  "parsers": [
    {
      "parser": "metasploit",
      "slug": "metasploit",
      "args": [],
      "description": "Metasploit Framework documentation from docs.metasploit.com"
    },
    {
      "parser": "caddy",
      "slug": "caddy",
      "args": ["--version", "2"],
      "description": "Caddy 2 documentation from github.com/caddyserver/website"
    },
    {
      "parser": "laravel",
      "slug": "laravel~{v}",
      "args": ["--version", "{v}"],
      "versions": ["4.0", "4.1", "4.2", "5.0", "5.1", "5.2", "5.3", "5.4", "5.5", "5.6", "5.7", "5.8"],
      "description": "Laravel docs from github.com/laravel/docs (branch {v})"
    },
    {
      "parser": "laravel",
      "slug": "laravel~{v}",
      "args": ["--version", "{v}.x"],
      "versions": ["6", "7", "8", "9", "10", "11", "12", "13"],
      "description": "Laravel docs from github.com/laravel/docs (branch {v}.x)"
    },
    {
      "parser": "go-dev",
      "slug": "go-dev",
      "args": ["--mode", "overview"],
      "description": "Go conceptual docs from go.dev (install, Effective Go, FAQ, modules, spec)"
    },
    {
      "parser": "go-dev",
      "slug": "go-dev~{v}",
      "args": ["--mode", "release", "--version", "{v}"],
      "versions": ["1.1", "1.2", "1.3", "1.4", "1.5", "1.6", "1.7", "1.8", "1.9", "1.10", "1.11", "1.12", "1.13", "1.14", "1.15", "1.16", "1.17", "1.18", "1.19", "1.20", "1.21", "1.22", "1.23", "1.24", "1.25", "1.26"],
      "description": "Go {v} release notes from go.dev"
    },
    {
      "parser": "go-std",
      "slug": "go-std~{v}",
      "args": ["--version", "{v}"],
      "versions": ["1.22", "1.23", "1.24", "1.25"],
      "description": "Go {v} standard library via go doc in Docker"
    },
    {
      "parser": "mongodb",
      "slug": "mongodb~{v}",
      "args": ["--version", "v{v}"],
      "versions": ["7.0", "8.0", "8.3"],
      "description": "MongoDB {v} Manual from github.com/mongodb/docs"
    },
    {
      "parser": "mdsite",
      "slug": "docker",
      "args": ["--site", "docker"],
      "description": "Docker docs (manuals, guides, CLI reference) from github.com/docker/docs"
    },
    {
      "parser": "mdsite",
      "slug": "kubernetes_docs",
      "args": ["--site", "kubernetes_docs"],
      "description": "Kubernetes docs (concepts, tasks, tutorials, reference) from github.com/kubernetes/website"
    },
    {
      "parser": "mdsite",
      "slug": "helm",
      "args": ["--site", "helm"],
      "description": "Helm docs from github.com/helm/helm-www"
    },
    {
      "parser": "mdsite",
      "slug": "prometheus",
      "args": ["--site", "prometheus"],
      "description": "Prometheus docs from github.com/prometheus/docs and prometheus/prometheus"
    },
    {
      "parser": "mdsite",
      "slug": "traefik",
      "args": ["--site", "traefik"],
      "description": "Traefik Proxy docs from github.com/traefik/traefik"
    },
    {
      "parser": "mdsite",
      "slug": "argo_cd",
      "args": ["--site", "argo_cd"],
      "description": "Argo CD docs from github.com/argoproj/argo-cd"
    },
    {
      "parser": "mdsite",
      "slug": "istio",
      "args": ["--site", "istio"],
      "description": "Istio docs from github.com/istio/istio.io"
    },
    {
      "parser": "mdsite",
      "slug": "opentelemetry",
      "args": ["--site", "opentelemetry"],
      "description": "OpenTelemetry docs from github.com/open-telemetry/opentelemetry.io"
    },
    {
      "parser": "mdsite",
      "slug": "grafana",
      "args": ["--site", "grafana"],
      "description": "Grafana docs from github.com/grafana/grafana"
    },
    {
      "parser": "mdsite",
      "slug": "loki",
      "args": ["--site", "loki"],
      "description": "Grafana Loki docs from github.com/grafana/loki"
    },
    {
      "parser": "mdsite",
      "slug": "podman",
      "args": ["--site", "podman"],
      "description": "Podman man pages from github.com/containers/podman"
    },
    {
      "parser": "mdsite",
      "slug": "vagrant",
      "args": ["--site", "vagrant"],
      "description": "Vagrant docs (latest version) from github.com/hashicorp/web-unified-docs"
    }
  ]
}
