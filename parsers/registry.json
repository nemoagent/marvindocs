{
  "parsers": [
    {
      "parser": "metasploit",
      "slug": "metasploit",
      "args": [],
      "description": "Metasploit Framework documentation from docs.metasploit.com"
    },
    {
      "parser": "caddy",
      "slug": "caddy",
      "args": ["--version", "2"],
      "description": "Caddy 2 documentation from github.com/caddyserver/website"
    },
    {
      "parser": "laravel",
      "slug": "laravel~{v}",
      "args": ["--version", "{v}"],
