# marvindocs local configuration. Copy to .env (git-ignored); it is read
# by scripts/update.sh, docker compose and, via the environment, by the
# marvindocs binary (flags still win over these values).

# Embedder used by `index embed` and `serve` when --embedder is not given:
#   onnx    local bge-m3 on CPU (default; slow but needs nothing external)
#   ollama  external Ollama server, see MARVINDOCS_OLLAMA_*
#   none    lexical search only
#MARVINDOCS_EMBEDDER=onnx

# Ollama server (MARVINDOCS_EMBEDDER=ollama).
#MARVINDOCS_OLLAMA_URL=http://localhost:11434
#MARVINDOCS_OLLAMA_MODEL=bge-m3

# ONNX files (MARVINDOCS_EMBEDDER=onnx); scripts/fetch-onnx.sh fills data/onnx.
#MARVINDOCS_MODEL_DIR=data/onnx/model
#MARVINDOCS_ONNXRUNTIME=data/onnx/lib/libonnxruntime.so

# HTTP auth for `serve --http` on a non-loopback address / docker compose.
#MARVINDOCS_AUTH_TOKEN=
#MARVINDOCS_INSECURE=
